{
  "schemaVersion": "1.1.0",
  "adapterId": "pi-runtime",
  "displayName": "Pi Coding Agent Runtime",
  "status": "DISABLED_BY_DEFAULT",
  "runtimeRole": "DEVELOPER_EXECUTION_ADAPTER",
  "executionBoundary": "LOCAL_OR_SANDBOXED_WORKER_ONLY",
  "cloudflareWorkerExecutionAllowed": false,
  "networkBoundary": "POLICY_CONTROLLED",
  "authenticationAssumption": "BYOK_VIA_CREDENTIAL_HANDLE",
  "parallelMutationsAllowed": false,
  "receiptRequired": true,
  "sessionPersistence": "IN_MEMORY_ONLY",
  "resourceDiscoveryPolicy": "ISOLATED_AND_ATTESTED",
  "defaultMode": "ADVISORY",
  "sdk": {
    "package": "@earendil-works/pi-coding-agent",
    "version": "0.83.0",
    "pinPolicy": "EXACT",
    "pilotVerifiedAt": "2026-08-11",
    "source": "npm"
  },
  "modes": {
    "ADVISORY": {
      "tools": ["read", "grep", "find", "ls"],
      "mutationsAllowed": false,
      "approvalRequired": false
    },
    "DRAFT": {
      "tools": ["read", "grep", "find", "ls", "edit"],
      "mutationsAllowed": true,
      "approvalRequired": true
    },
    "EXECUTE": {
      "tools": ["read", "grep", "find", "ls", "edit", "write", "bash"],
      "mutationsAllowed": true,
      "approvalRequired": true,
      "sandboxRequired": true
    }
  },
  "capabilityMap": {
    "agentropolis.dev.read": ["read", "grep", "find", "ls"],
    "agentropolis.dev.edit": ["edit"],
    "agentropolis.dev.write": ["write"],
    "agentropolis.dev.shell": ["bash"]
  },
  "activationRequirements": [
    "approved_worker",
    "pi_sdk_available",
    "sdk_exact_version_attested",
    "workspace_identity_verified",
    "credential_handle_resolved",
    "effective_capabilities_attested",
    "resource_discovery_isolated",
    "egress_policy_loaded",
    "receipt_destination_configured",
    "operator_or_policy_approval_for_mutation"
  ],
  "killConditions": [
    "raw_secret_requested",
    "sdk_version_mismatch",
    "workspace_identity_mismatch",
    "capability_escalation_detected",
    "resource_discovery_not_isolated",
    "sandbox_required_but_missing",
    "egress_policy_violation",
    "receipt_generation_failed",
    "authority_revoked"
  ],
  "canonicalContract": "docs/PI_RUNTIME_ADAPTER.md"
}
